# ── Server ──
PORT=8080
# Comma-separated EXTRA allowed frontend origins (CORS). The Hostinger temp domain,
# lilynailstudio.in and www are already allowed in code; add more here if needed.
CORS_ORIGINS=https://lilynailstudio.in,https://www.lilynailstudio.in

# ── Hostinger MySQL ──
# From hPanel → Databases → MySQL Databases (host is usually "localhost" on Hostinger).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── Razorpay ──
# Use test keys first (rzp_test_...). Switch to live keys after KYC activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket ──
# The email/password of your Shiprocket API user (Settings → API → Create API User).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The exact pickup location nickname configured in Shiprocket (Settings → Pickup Addresses).
SHIPROCKET_PICKUP_LOCATION=Primary

# ── Store / package defaults ──
# Default parcel dimensions (cm) and weight (kg) for a press-on nail order.
PARCEL_LENGTH_CM=15
PARCEL_BREADTH_CM=12
PARCEL_HEIGHT_CM=3
PARCEL_WEIGHT_KG=0.3

# ── Runtime ──
# Set to "production" on Hostinger so missing secrets fail fast + strict CORS applies.
NODE_ENV=production
# Hard timeout (ms) for external API calls (Shiprocket).
EXTERNAL_TIMEOUT_MS=12000
# Secret key for admin-only endpoints (manual shipment retry). Set a long random string.
ADMIN_KEY=
